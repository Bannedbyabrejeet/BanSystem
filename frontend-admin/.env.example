# URL base del Servicio 1 (FastAPI).
# Vacio = misma origen, el proxy de Vite reenvia /api a 127.0.0.1:8000 (recomendado).
# Para un backend en otro origen: http://localhost:8000/api/v1
VITE_API_BASE_URL=

# Destino del proxy de Vite en desarrollo (solo lectura en vite.config.js).
# Cambielo si el Servicio 1 no escucha en el puerto 8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Nombre mostrado en la interfaz.
VITE_APP_NAME=Bannedbyabrejeet