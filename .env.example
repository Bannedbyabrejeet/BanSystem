# Copie este archivo a .env y sustituya todos los secretos de ejemplo.
REDIS_PASSWORD=cambie-esta-contrasena-redis
JWT_SECRET=cambie-este-secreto-jwt-de-al-menos-32-bytes-aleatorio

# Redis corre en Docker (docker compose up -d redis) y el backend en la maquina,
# asi que se alcanza por loopback. Estos valores son los predeterminados.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0

# URL usada para construir /reset-password?token=...
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=bannedbyabrejeet:service1
JWT_AUDIENCE=bannedbyabrejeet:admin-console

# Coste de Argon2id (iteraciones, memoria en KiB, hilos).
# La memoria debe ser al menos 8 veces el paralelismo.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
RESET_TOKEN_TTL=900

# development | testing | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Reintentos de conexión a Redis durante el arranque del backend.
REDIS_STARTUP_RETRIES=10
REDIS_STARTUP_RETRY_DELAY=2

# Servicio 2 (motor de seguridad / lector de logs SSH).
# En Debian/Ubuntu el auth log está en /var/log/auth.log; en RHEL, /var/log/secure.
SSH_LOG_PATH=/var/log/auth.log
# false = solo eventos nuevos (tail -f); true = procesa el archivo completo.
LOG_READ_FROM_START=false
LOG_POLL_INTERVAL=0.5

# Integración UFW (Issue #8). El proceso debe poder ejecutar `ufw` (root o
# sudo sin contraseña). Con UFW_DRY_RUN=true solo se registran los comandos.
UFW_DRY_RUN=false
UFW_BINARY=ufw
UFW_USE_SUDO=true
UFW_SSH_PORT=22
UFW_COMMAND_TIMEOUT=10

# Expiración de baneos y worker del stream de desbaneo manual.
BAN_MAINTENANCE_INTERVAL=5
UNBAN_STREAM=security:events:unban
UNBAN_CONSUMER_GROUP=ufw_workers
UNBAN_CONSUMER_NAME=
UNBAN_BLOCK_MS=1000
UNBAN_BATCH_SIZE=10
UNBAN_RETRY_MIN_IDLE_MS=5000

# log: imprime el enlace de recuperación en los logs (solo desarrollo).
# smtp: entrega el correo mediante el servidor SMTP configurado.
MAIL_MODE=log
MAIL_FROM=noreply@bannedbyabrejeet.local
MAIL_FROM_NAME=Bannedbyabrejeet
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false