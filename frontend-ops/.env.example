# URL del login del Frontend A. Por defecto se usa el mismo origen (/login),
# que es el modo recomendado detrás del proxy inverso del ADR 001.
VITE_ADMIN_LOGIN_URL=/login
# Opcional: URL del dashboard del Frontend A.
# VITE_ADMIN_DASHBOARD_URL=/dashboard

# Destinos de los proxies de Vite (solo desarrollo).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# VITE_TELEMETRY_PROXY_TARGET=http://127.0.0.1:5000
